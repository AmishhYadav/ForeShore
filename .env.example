# FORESHORE environment — copy to .env and fill. Nothing on the demo critical path
# requires a key; every entry below is an upgrade, not a dependency.

# Agent core. Without it the runtime falls back to the deterministic scripted planner
# (same tools, same trace, no LLM prose).
ANTHROPIC_API_KEY=
FORESHORE_LLM_MODEL=claude-sonnet-4-5

# live | fixture  — fixture replays data/fixtures/ with the network off
FORESHORE_MODE=live
FORESHORE_REGION=palk_bay_gom

# PostGIS (docker-compose up -d). Absent => file-backed vector store from data/static/
FORESHORE_PG_DSN=postgresql://foreshore:foreshore@localhost:55432/foreshore

# Registration-gated upside. Keyless fallbacks are already wired for every field.
IMD_API_TOKEN=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
BHASHINI_UDYAT_KEY=
BHASHINI_INFERENCE_API_KEY=
BHASHINI_USER_ID=
